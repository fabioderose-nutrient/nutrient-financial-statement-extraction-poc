<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FinancialExtraction.Api</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>osx-x64;linux-x64;win-x64</RuntimeIdentifiers>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GdPicture.XtractFlow" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Spec\fields_spec.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Spec\field_descriptions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
