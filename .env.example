# GdPicture / XtractFlow license key. Empty = evaluation mode.
GDPICTURE_LICENSE_KEY=
# Nutrient Web SDK license key, served to the browser by GET /api/config. Empty = evaluation mode (watermark).
NUTRIENT_WEB_LICENSE_KEY=
# OpenAI API key used by XtractFlow for the extraction.
OPENAI_API_KEY=
# gpt-4o (default), gpt-5-mini, gpt-5-nano or o3-mini.
OPENAI_MODEL=gpt-4o
# Timeout of one XtractFlow LLM inference, in seconds.
LLM_TIMEOUT_SECONDS=600
# Number of extraction passes sent to the LLM at the same time.
MAX_PARALLEL_BATCHES=3
# Folder with latin.traineddata. Only needed for scanned PDFs.
OCR_RESOURCES_PATH=
# Address the server listens on.
ASPNETCORE_URLS=http://localhost:5000
